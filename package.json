{
  "name": "coc.nvim-master",
  "version": "0.0.82",
  "description": "LSP based intellisense engine for neovim & vim9.",
  "main": "./build/index.js",
  "bin": {
    "coc-mcp": "bin/coc-mcp.js"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "type": "commonjs",
  "scripts": {
    "lint": "npm run check:watcher-binaries && oxlint . && nvim --headless -u NONE -c 'helptags doc' -c 'q'",
    "lint:typecheck": "tsc -p tsconfig.json",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "node scripts/test/cli.mjs",
    "test:unit": "node scripts/test/cli.mjs --unit",
    "test:coverage": "node --enable-source-maps scripts/test/cli.mjs -j 4 --coverage",
    "test:watcher-binary": "node scripts/test-watcher-binary.mjs",
    "prepare": "node esbuild.js",
    "check:watcher-binaries": "node scripts/update-watcher-binaries.mjs --check",
    "update:watcher-binaries": "node scripts/update-watcher-binaries.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neoclide/coc.nvim.git"
  },
  "keywords": [
    "complete",
    "neovim"
  ],
  "author": "Qiming Zhao <chemzqm@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/neoclide/coc.nvim/issues"
  },
  "homepage": "https://github.com/neoclide/coc.nvim#readme",
  "devDependencies": {
    "@types/debounce": "^1.2.4",
    "@types/fb-watchman": "^2.0.6",
    "@types/follow-redirects": "^1.14.4",
    "@types/node": "^24.13",
    "@types/semver": "^7.8.0",
    "@types/unidecode": "^1.1.0",
    "@types/which": "^3.0.4",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.3",
    "vscode-languageserver": "^10.1.1"
  },
  "dependencies": {
    "@chemzqm/neovim": "^6.4.0",
    "ansi-styles": "^7.0.0",
    "bytes": "^3.1.2",
    "cli-table": "^0.3.11",
    "content-disposition": "^3.0.0",
    "debounce": "^3.0.0",
    "decompress-response": "^10.0.0",
    "fast-diff": "^1.3.0",
    "fb-watchman": "^2.0.2",
    "follow-redirects": "^1.16.0",
    "glob": "^13.0.6",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "iconv-lite": "^0.7.3",
    "is-glob": "^4.0.3",
    "jsonc-parser": "^3.3.1",
    "marked": "^10.0.0",
    "minimatch": "^10.2.6",
    "picomatch": "^4.0.4",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "tslib": "^2.8.1",
    "unidecode": "^1.1.0",
    "vscode-languageserver-protocol": "^3.18.3",
    "vscode-languageserver-textdocument": "^1.0.14",
    "vscode-languageserver-types": "^3.18.3",
    "vscode-uri": "^3.2.0",
    "which": "^7.0.0",
    "yauzl": "^3.4.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
